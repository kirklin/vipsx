# libvips, GLib and the Go runtime all keep pools alive for the life of the
# process on purpose. Those are reachable at exit, not lost, so this file
# suppresses the noise and leaves definite losses reported.

{
   glib-type-registration
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   ...
   fun:g_type_register_*
}

{
   glib-quark-and-intern
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   ...
   fun:g_quark_*
}

{
   glib-once-init
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   ...
   fun:g_once_init_enter*
}

{
   vips-startup-tables
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   ...
   fun:vips_init
}

{
   vips-operation-cache-retains-by-design
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:vips_cache_operation_add
}

{
   go-runtime-stacks
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   ...
   fun:runtime.*
}

{
   dyld-and-loader
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   ...
   obj:*/ld-*.so
}
